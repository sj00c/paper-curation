# Everything excluded by default, then whitelist
*

# Whitelist: core project files
!.gitignore
!.nojekyll
!README.md
!README.en.md
!SKILL.md
!SKILL.md.template
!config.example.json
!.env.example
!requirements.txt
!wrangler.toml
!CLAUDE.md
!workflow.png
!package.json
!bin/
!bin/*.mjs
!tests/
!tests/*.mjs

# Reviewed vendored Audio codec runtime
!vendor/
!vendor/lamejs/
!vendor/lamejs/lame.all.js
!vendor/lamejs/LICENSE

# Managed internal skill bundle rendered by bin/paper-curation.mjs
!skills/
!skills/manifest.json
!skills/SKILL.md.template

# Pipeline scripts
!pipeline/
!pipeline/*.py
!pipeline/lib/
!pipeline/lib/*.py
!pipeline/api/
!pipeline/api/*.py
!pipeline/_archive/
!pipeline/_archive/*.py
!pipeline/tests/
!pipeline/tests/*.py
!pipeline/tests/*.mjs

# Cloudflare Worker function (handles /api/audio-email + serves static assets).
# Deployed by `wrangler deploy` alongside docs/.
!worker/
!worker/*.js

# Git hooks installer + helper scripts
!scripts/
!scripts/*

# CI workflows
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Double-click launchers (serve docs/ + open topic site on localhost)
!open.command
!open_*.command

# Documentation (whitelist specific service files below; provenance records are audit-only,
# not a whitelist for upstream patches, API responses, or source material)
!docs/
!docs/index.html
!docs/setup-guide.md
!docs/operations.md
!docs/architecture.md
!docs/upstream-integration-provenance.md
!docs/audio-codec-provenance.md

# Public assets (conference talk slides, etc.) — tracked on master + GitHub-served
!docs/public/
!docs/public/**

# Generated topic content stays local/gitignored. Product deployment is a
# separate scope-checked, operation-approved command and is never automatic.
!docs/.assetsignore

# Legacy generated secret/cache files remain ignored. Canonical localhost
# dashboards are secret-free and never create or read these paths.
docs/_local_keys.json
docs/_zotero_keys.json

# Exclude local config and temp files
config.json
__pycache__/
pipeline/__pycache__/
pipeline/lib/__pycache__/
pipeline/_update_force_checkpoint.json
pipeline/_update_force.log
pipeline/_img_timelines/
pipeline/_img_workflows/*
!pipeline/_img_workflows/workflow.png
_regen_*.py

# Exclude Claude Code / OMC runtime files that may land under docs/
docs/**/.claude/
docs/**/.omc/

# Exclude Obsidian vault files
docs/.obsidian/
docs/**/.obsidian/

# Exclude internal planning / spec drafts
docs/superpowers/


# Auto-generated by prepare_deploy.py
papers/*/text.md
