#!/bin/sh
# paper-curation-managed-pre-push
# Install with scripts/install-hooks.sh.

set -eu

if ! REPO_ROOT=$(git rev-parse --show-toplevel); then
    echo "[pre-push] cannot identify the current repository; refusing push" >&2
    exit 1
fi
SCANNER="$REPO_ROOT/scripts/scan-secrets.py"

if [ ! -f "$SCANNER" ]; then
    echo "[pre-push] security scanner is missing; refusing push" >&2
    exit 1
fi

updates=0
while IFS=' ' read -r local_ref local_oid remote_ref remote_oid extra || [ -n "${local_ref:-}${local_oid:-}${remote_ref:-}${remote_oid:-}${extra:-}" ]; do
    if [ -z "${local_ref:-}" ] || [ -z "${local_oid:-}" ] || [ -z "${remote_ref:-}" ] || [ -z "${remote_oid:-}" ] || [ -n "${extra:-}" ]; then
        echo "[pre-push] malformed ref update; refusing push" >&2
        exit 1
    fi
    updates=$((updates + 1))
    if ! python3 "$SCANNER" --update "$local_ref" "$local_oid" "$remote_ref" "$remote_oid"; then
        echo "[pre-push] security scan failed; refusing push" >&2
        exit 1
    fi
done

if [ "$updates" -gt 0 ]; then
    echo "[pre-push] security scan passed for $updates update(s)"
fi

exit 0
