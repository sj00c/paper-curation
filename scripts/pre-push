#!/bin/sh
# pre-push hook for paper-curation
# Install: bash scripts/install-hooks.sh   (idempotent, self-verifying)
#
# Design — two tiers so the security guard is always on without slowing pushes:
#   1. Secret-leak scan  → HARD BLOCK. `scan-secrets.py` consumes the exact
#      pre-push ref list from stdin, enumerates introduced git objects, and reads
#      raw commit/tag/blob bytes. It does not depend on patch/diff generation.
#   2. validate_papers   → ADVISORY (warns, never blocks). It is a deploy gate,
#      not a push gate. Blocking every push on unrelated data issues would train
#      `git push --no-verify`, which also disables the secret scan.
#
# `git push --no-verify` is also blocked by the agent PreToolUse guard.

set -e

ROOT="$(git rev-parse --show-toplevel)"

# ── 1. Raw git-object secret scan (HARD BLOCK, fail closed) ──────────────────
echo "[pre-push] scanning raw pushed git objects for credential material…"
python3 "$ROOT/scripts/scan-secrets.py"

# ── 2. validate_papers (ADVISORY — never blocks the push) ───────────────────
TOPIC="${PAPER_CURATION_TOPIC:-ai4s}"
if [ -f pipeline/validate_papers.py ]; then
    echo "[pre-push] validate_papers --topic $TOPIC --strict (advisory)"
    # `python` 은 이 저장소가 요구하는 py312 환경에 존재하지 않는다 (21 줄과 마찬가지로
    # python3 를 쓴다). 여기만 `python` 이라 훅이 "command not found" 로 넘어가고,
    # advisory 검사가 실제로는 한 번도 돌지 않았다.
    if ! PYTHONUTF8=1 python3 pipeline/validate_papers.py --topic "$TOPIC" --strict >/tmp/_pp_validate.log 2>&1; then
        echo "[pre-push] ⚠ validate_papers reported issues (not blocking push):"
        tail -12 /tmp/_pp_validate.log
        echo "[pre-push] ⚠ fix before deploy — CI and prepare_deploy enforce this hard."
    else
        echo "[pre-push] ✓ validate_papers passed"
    fi
fi

exit 0
