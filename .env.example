# Paper Curation — local credentials
#
# 1. cp .env.example .env
# 2. Open .env and add the credentials for the features you use.
# 3. npx . setup --auth oauth
#
# In OAuth mode Claude uses the saved `claude auth login` session; API-key mode
# uses ANTHROPIC_API_KEY. Setup discovers Zotero collections and creates a
# local PDF cache.

# Required: Zotero library and attachment access
ZOTERO_API_KEY=

# Optional: figure validation, dense search embeddings, and TTS
# GOOGLE_API_KEY is accepted as an equivalent variable name.
GEMINI_API_KEY=