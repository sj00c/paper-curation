# Paper Curation — local credentials
#
# 1. cp .env.example .env
# 2. Add only credentials for providers explicitly selected in config.json.
#
# Credential presence never enables a provider or feature. Claude Code OAuth
# normally uses the saved `claude auth login` session without an environment
# token.

# Required only when source.transport is zotero-storage. Local SQLite needs no key.
ZOTERO_API_KEY=

# Required only when core.review.provider is anthropic-api.
ANTHROPIC_API_KEY=

# Required only for an explicit public Cloudflare deploy.
CLOUDFLARE_API_TOKEN=