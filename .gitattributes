# Preserve each file's existing line endings. The repository contains both
# CRLF and LF files, and automatic conversion would create whole-file diffs.
* -text

# 바이너리는 diff/머지 시도 자체를 막는다.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.pdf  binary
*.ico  binary
*.mp3  binary
*.woff  binary
*.woff2 binary
*.joblib binary
*.npy  binary
*.sqlite binary
